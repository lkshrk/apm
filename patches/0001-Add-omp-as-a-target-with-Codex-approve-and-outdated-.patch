index 000000000..382bcba7a
--- /dev/null
+++ b/src/apm_cli/integration/extension_bundle_install.py
@@ -0,0 +1,225 @@
+"""Validate offline native payloads before delegating atomic owned deployment."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import dataclass
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any
+
+from apm_cli.integration.base_integrator import BaseIntegrator
+from apm_cli.integration.extension_discovery import find_extension_bundles, is_native_extension_path
+from apm_cli.integration.extension_integrator import (
+    RECEIPT_FILENAME,
+    ExtensionIntegrator,
+    _native_names,
+)
+from apm_cli.utils.content_hash import _canonical_hash_bytes, compute_file_hash
+from apm_cli.utils.path_security import (
+    ensure_path_within,
+    has_symlink_component,
+    validate_path_segments,
+)
+from apm_cli.utils.paths import portable_relpath
+
+
+@dataclass(frozen=True)
+class NativeBundlePlan:
+    source_root: Path
+    package_name: str
+    files: tuple[str, ...]
+    targets: tuple[Any, ...]
+    target_paths: tuple[Path, ...]
+    target_hashes: dict[Path, str]
+
+
+def plan_native_bundle_files(
+    bundle_dir: Path,
+    pack_files: dict[str, str],
+    targets: list[Any],
+    project_root: Path,
+    *,
+    managed_files: set[str] | None = None,
+    managed_file_hashes: dict[str, str] | None = None,
+) -> list[NativeBundlePlan]:
+    """Validate complete attested native packages and all collisions without writes."""
+    native_targets = tuple(target for target in targets if target.supports("extensions"))
+    if not native_targets:
+        return []
+    roots: dict[str, list[str]] = {}
+    for relative in pack_files:
+        if not is_native_extension_path(relative):
+            continue
+        validate_path_segments(relative, context="native bundle file")
+        parts = Path(relative).parts
+        index = parts.index("extensions")
+        if index + 2 >= len(parts):
+            raise ValueError(f"Native bundle entry is not a complete package file: {relative}")
+        root = Path(*parts[: index + 2]).as_posix()
+        roots.setdefault(root, []).append(relative)
+
+    integrator = ExtensionIntegrator()
+    plans: list[NativeBundlePlan] = []
+    package_names: set[str] = set()
+    extension_names: set[str] = set()
+    for relative_root, files in sorted(roots.items()):
+        source = bundle_dir / relative_root
+        ensure_path_within(source, bundle_dir)
+        if has_symlink_component(bundle_dir, source):
+            raise ValueError(f"Symlinked native bundle root: {relative_root}")
+        listed = set(files)
+        actual: set[str] = set()
+        for directory, directories, names in BaseIntegrator.walk_source_tree(source):
+            base = Path(directory)
+            for name in (*directories, *names):
+                if (base / name).is_symlink():
+                    raise ValueError(f"Symlinked native bundle resource: {base / name}")
+            for name in names:
+                path = base / name
+                relative = path.relative_to(bundle_dir).as_posix()
+                actual.add(relative)
+                if relative not in listed:
+                    raise ValueError(f"Unattested native extension resource: {relative}")
+                digest = hashlib.sha256(path.read_bytes()).hexdigest()
+                if digest != pack_files[relative]:
+                    raise ValueError(f"Native extension resource hash mismatch: {relative}")
+        if actual != listed:
+            raise ValueError(f"Missing native extension resources: {sorted(listed - actual)}")
+        bundles = find_extension_bundles(source)
+        if not bundles:
+            raise ValueError(f"Native bundle has no declared executable artifacts: {relative_root}")
+        name = source.name
+        owner = name
+        receipt_path = source / RECEIPT_FILENAME
+        if receipt_path.is_file():
+            receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
+            if (
+                not isinstance(receipt, dict)
+                or not isinstance(receipt.get("owner"), str)
+                or not receipt["owner"]
+            ):
+                raise ValueError(f"Invalid native bundle ownership receipt: {relative_root}")
+            owner = receipt["owner"]
+            if integrator._name(bundles[0], owner) != name:
+                raise ValueError(
+                    f"Native bundle owner does not match its deployment directory: {relative_root}"
+                )
+        if name in package_names:
+            raise ValueError(f"Duplicate native extension package in bundle: {name}")
+        package_names.add(name)
+        names = set().union(*(_native_names(source, bundle.entries) for bundle in bundles))
+        if names & extension_names:
+            raise ValueError(
+                f"Duplicate native extension names in bundle: {sorted(names & extension_names)}"
+            )
+        extension_names.update(names)
+        integrator.preflight_extensions_for_targets(
+            list(native_targets),
+            SimpleNamespace(install_path=source),
+            project_root,
+            package_name=owner,
+            managed_files=managed_files,
+            managed_file_hashes=managed_file_hashes,
+        )
+        payload = integrator.render_payload(bundles[0], owner)
+        hashes = {
+            relative: "sha256:" + hashlib.sha256(_canonical_hash_bytes(data)).hexdigest()
+            for relative, data in payload.items()
+        }
+        target_hashes = {
+            project_root
+            / (mapping.deploy_root or target.root_dir)
+            / mapping.subdir
+            / name
+            / relative: digest
+            for target in native_targets
+            for mapping in (target.primitives["extensions"],)
+            for relative, digest in hashes.items()
+        }
+        plans.append(
+            NativeBundlePlan(
+                source,
+                owner,
+                tuple(sorted(files)),
+                native_targets,
+                tuple(target_hashes),
+                target_hashes,
+            )
+        )
+    return plans
+
+
+def integrate_native_bundle_plans(
+    plans: list[NativeBundlePlan],
+    project_root: Path,
+    *,
+    managed_files: set[str] | None = None,
+    managed_file_hashes: dict[str, str] | None = None,
+    diagnostics=None,
+) -> list[Path]:
+    """Install preflighted packages with receipt-backed atomic bundle ownership."""
+    integrator = ExtensionIntegrator()
+    paths: list[Path] = []
+    for plan in plans:
+        for target in plan.targets:
+            result = integrator.integrate_extensions_for_target(
+                target,
+                SimpleNamespace(install_path=plan.source_root),
+                project_root,
+                package_name=plan.package_name,
+                managed_files=managed_files,
+                managed_file_hashes=managed_file_hashes,
+                diagnostics=diagnostics,
+                trust_extensions=True,
+            )
+            paths.extend(result.target_paths)
+    return paths
+
+
+def deploy_native_bundle_files(
+    bundle_dir: Path,
+    pack_files: dict[str, str],
+    targets: list[Any],
+    project_root: Path,
+    *,
+    dry_run: bool,
+    managed_files: set[str] | None = None,
+    managed_file_hashes: dict[str, str] | None = None,
+    diagnostics=None,
+) -> tuple[list[NativeBundlePlan], dict[str, str]]:
+    """Plan native packages, drop their files from ``pack_files`` in place, and apply.
+
+    Returns the plans plus ``{project-relative path: hash}`` for every native
+    destination. ``dry_run`` reports the planned destinations and hashes
+    without writing.
+    """
+    plans = plan_native_bundle_files(
+        bundle_dir,
+        pack_files,
+        targets,
+        project_root,
+        managed_files=managed_files,
+        managed_file_hashes=managed_file_hashes,
+    )
+    for plan in plans:
+        for relative in plan.files:
+            pack_files.pop(relative, None)
+    if dry_run:
+        native_paths = [path for plan in plans for path in plan.target_paths]
+        native_hashes = {
+            path: digest for plan in plans for path, digest in plan.target_hashes.items()
+        }
+    else:
+        native_paths = integrate_native_bundle_plans(
+            plans,
+            project_root,
+            managed_files=managed_files,
+            managed_file_hashes=managed_file_hashes,
+            diagnostics=diagnostics,
+        )
+        native_hashes = {path: compute_file_hash(path) for path in native_paths}
+    return plans, {
+        portable_relpath(path, project_root): native_hashes[path] for path in native_paths
+    }
diff --git a/src/apm_cli/integration/extension_discovery.py b/src/apm_cli/integration/extension_discovery.py
new file mode 100644
index 000000000..c42b898c3
--- /dev/null
+++ b/src/apm_cli/integration/extension_discovery.py
@@ -0,0 +1,199 @@
+"""Discover explicitly declared native extensions without importing executable code."""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from pathlib import Path, PurePosixPath
+
+_NATIVE_SUFFIXES = frozenset({".ts", ".js", ".mjs", ".cjs"})
+_SOURCE_DIRS = (".omp/extensions", ".pi/extensions", ".apm/extensions")
+
+
+@dataclass(frozen=True)
+class ExtensionBundle:
+    """A package snapshot and its package-relative native entry points."""
+
+    source_root: Path
+    name: str
+    entries: tuple[str, ...]
+
+
+def native_extension_name(path: Path) -> str:
+    """Match omp's capability identity for an explicitly resolved entry path."""
+    return path.parent.name if path.name in ("index.ts", "index.js") else path.stem
+
+
+def native_extension_declaration(package_path: Path) -> list[str] | None:
+    """Return the authoritative omp/pi declaration, including unbuilt entries.
+
+    Presence, not successful artifact discovery, determines precedence. A bad
+    native declaration must never silently enable the portable hook adapter.
+    """
+    manifest = package_path / "package.json"
+    if not manifest.is_file():
+        return None
+    try:
+        data = json.loads(manifest.read_text(encoding="utf-8"))
+    except (OSError, ValueError) as exc:
+        raise ValueError(f"Cannot read native package manifest {manifest}: {exc}") from exc
+    if not isinstance(data, dict):
+        return None
+    for namespace in ("omp", "pi"):
+        section = data.get(namespace)
+        if section is None:
+            continue
+        # Native discovery selects the omp object before considering pi,
+        # rather than merging fields from the two namespaces.
+        if not isinstance(section, dict) or "extensions" not in section:
+            return None
+        if isinstance(section, dict) and "extensions" in section:
+            entries = section["extensions"]
+            if (
+                not isinstance(entries, list)
+                or not entries
+                or not all(isinstance(entry, str) and entry for entry in entries)
+            ):
+                raise ValueError(
+                    f"{manifest}: {namespace}.extensions must be a non-empty list of paths"
+                )
+            return entries
+    return None
+
+
+def has_native_extension_manifest(package_path: Path) -> bool:
+    """Whether a package explicitly declares native executable entry points."""
+    return native_extension_declaration(package_path) is not None
+
+
+def _entry(root: Path, value: str) -> str:
+    # Reject traversal rather than normalizing it: declared entries are portable
+    # package-relative paths, never host paths or links outside the snapshot.
+    path = PurePosixPath(value)
+    if "\\" in value or path.is_absolute() or ".." in path.parts or ":" in value:
+        raise ValueError(f"Unsafe native extension entry {value!r} in {root}")
+    source = root.joinpath(*path.parts)
+    if source.is_dir():
+        source = next(
+            (source / name for name in ("index.ts", "index.js") if (source / name).is_file()),
+            source,
+        )
+    try:
+        relative = source.relative_to(root)
+    except ValueError as exc:
+        raise ValueError(f"Unsafe native extension entry {value!r} in {root}") from exc
+    cursor = root
+    for component in relative.parts:
+        cursor = cursor / component
+        if cursor.is_symlink():
+            raise ValueError(f"Symlinked native extension entry {value!r} in {root}")
+    if source.suffix not in _NATIVE_SUFFIXES or not source.is_file():
+        raise ValueError(
+            f"Missing or unsupported declared native extension {value!r} in {root}. "
+            "Ship the built or vendored artifact; APM does not run npm installs or builds."
+        )
+    return relative.as_posix()
+
+
+def find_extension_bundles(
+    package_path: Path, *, validate_entries: bool = True, is_first_party: bool = False
+) -> list[ExtensionBundle]:
+    """Find native package manifests or designated extension source directories.
+
+    Dependencies keep their full package root to preserve imports and resources.
+    First-party project content is bounded to .apm/extensions; ambient native
+    deployment directories are never promoted back into executable source.
+    Arbitrary root index.js files never opt a package into executable deployment.
+    """
+    package_root = Path(package_path)
+    root = package_root
+    if is_first_party:
+        if native_extension_declaration(package_root) is not None:
+            raise ValueError(
+                "Project-root native extension manifests are not deployable: copying "
+                "the whole project could include private files. Put a self-contained "
+                "extension package and its assets under .apm/extensions instead."
+            )
+        root = package_root / ".apm" / "extensions"
+        from apm_cli.utils.path_security import has_symlink_component
+
+        if has_symlink_component(package_root, root):
+            raise ValueError(f"Symlinked first-party extension source directory: {root}")
+        if not root.is_dir():
+            return []
+    source_directories = (
+        (root,) if is_first_party else tuple(root / source for source in _SOURCE_DIRS)
+    )
+
+    def entry(base: Path, value: str) -> str:
+        return _entry(base, value) if validate_entries else value
+
+    declaration = native_extension_declaration(root)
+    entries: list[str] = []
+    if declaration is not None:
+        entries.extend(entry(root, value) for value in declaration)
+    else:
+        for base in source_directories:
+            if validate_entries and base.is_symlink():
+                raise ValueError(f"Symlinked native extension source directory: {base}")
+            if not base.is_dir():
+                continue
+            for child in sorted(base.iterdir()):
+                if child.is_dir() and (child / ".apm-extension.json").is_file():
+                    continue
+                if validate_entries and child.is_symlink():
+                    raise ValueError(f"Symlinked native extension source: {child}")
+                if child.is_file() and child.suffix in (".ts", ".js"):
+                    entries.append(entry(root, child.relative_to(root).as_posix()))
+                elif child.is_dir():
+                    nested = native_extension_declaration(child)
+                    if nested is not None:
+                        entries.extend(
+                            entry(root, (child.relative_to(root) / entry(child, value)).as_posix())
+                            for value in nested
+                        )
+                    else:
+                        index = next(
+                            (
+                                child / name
+                                for name in ("index.ts", "index.js")
+                                if (child / name).is_file()
+                            ),
+                            None,
+                        )
+                        if index is not None:
+                            entries.append(entry(root, index.relative_to(root).as_posix()))
+    if not entries:
+        return []
+    name = "_local" if is_first_party else root.name
+    return [ExtensionBundle(root, name, tuple(dict.fromkeys(entries)))]
+
+
+def has_native_extension_sources(project_root: Path) -> bool:
+    """Report authored first-party native extension factories without validating entries.
+
+    Existence probe for callers that must keep native sources out of portable
+    layouts or fail closed on them. Structural problems (symlinked or
+    root-manifest sources) count as present; they are reported by the validating
+    :func:`find_extension_bundles` callers, not hidden here.
+    """
+    try:
+        bundles = find_extension_bundles(project_root, validate_entries=False, is_first_party=True)
+        return bool(bundles)
+    except ValueError:
+        return True
+
+
+def is_native_extension_path(relative: str) -> bool:
+    """Identify native executable deployment payloads (not Copilot canvases)."""
+    parts = PurePosixPath(relative.replace("\\", "/")).parts
+    for index, part in enumerate(parts):
+        if part != "extensions":
+            continue
+        if index and parts[index - 1] in (".omp", ".pi"):
+            return True
+        if index >= 2 and parts[index - 2 : index] == (".omp", "agent"):
+            return True
+        if index == 0 or parts[index - 1].startswith("."):
+            return False
+    return False
