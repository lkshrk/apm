index 000000000..c42b898c3
--- /dev/null
+++ b/src/apm_cli/integration/extension_discovery.py
@@ -0,0 +1,199 @@
+"""Discover explicitly declared native extensions without importing executable code."""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from pathlib import Path, PurePosixPath
+
+_NATIVE_SUFFIXES = frozenset({".ts", ".js", ".mjs", ".cjs"})
+_SOURCE_DIRS = (".omp/extensions", ".pi/extensions", ".apm/extensions")
+
+
+@dataclass(frozen=True)
+class ExtensionBundle:
+    """A package snapshot and its package-relative native entry points."""
+
+    source_root: Path
+    name: str
+    entries: tuple[str, ...]
+
+
+def native_extension_name(path: Path) -> str:
+    """Match omp's capability identity for an explicitly resolved entry path."""
+    return path.parent.name if path.name in ("index.ts", "index.js") else path.stem
+
+
+def native_extension_declaration(package_path: Path) -> list[str] | None:
+    """Return the authoritative omp/pi declaration, including unbuilt entries.
+
+    Presence, not successful artifact discovery, determines precedence. A bad
+    native declaration must never silently enable the portable hook adapter.
+    """
+    manifest = package_path / "package.json"
+    if not manifest.is_file():
+        return None
+    try:
+        data = json.loads(manifest.read_text(encoding="utf-8"))
+    except (OSError, ValueError) as exc:
+        raise ValueError(f"Cannot read native package manifest {manifest}: {exc}") from exc
+    if not isinstance(data, dict):
+        return None
+    for namespace in ("omp", "pi"):
+        section = data.get(namespace)
+        if section is None:
+            continue
+        # Native discovery selects the omp object before considering pi,
+        # rather than merging fields from the two namespaces.
+        if not isinstance(section, dict) or "extensions" not in section:
+            return None
+        if isinstance(section, dict) and "extensions" in section:
+            entries = section["extensions"]
+            if (
+                not isinstance(entries, list)
+                or not entries
+                or not all(isinstance(entry, str) and entry for entry in entries)
+            ):
+                raise ValueError(
+                    f"{manifest}: {namespace}.extensions must be a non-empty list of paths"
+                )
+            return entries
+    return None
+
+
+def has_native_extension_manifest(package_path: Path) -> bool:
+    """Whether a package explicitly declares native executable entry points."""
+    return native_extension_declaration(package_path) is not None
+
+
+def _entry(root: Path, value: str) -> str:
+    # Reject traversal rather than normalizing it: declared entries are portable
+    # package-relative paths, never host paths or links outside the snapshot.
+    path = PurePosixPath(value)
+    if "\\" in value or path.is_absolute() or ".." in path.parts or ":" in value:
+        raise ValueError(f"Unsafe native extension entry {value!r} in {root}")
+    source = root.joinpath(*path.parts)
+    if source.is_dir():
+        source = next(
+            (source / name for name in ("index.ts", "index.js") if (source / name).is_file()),
+            source,
+        )
+    try:
+        relative = source.relative_to(root)
+    except ValueError as exc:
+        raise ValueError(f"Unsafe native extension entry {value!r} in {root}") from exc
+    cursor = root
+    for component in relative.parts:
+        cursor = cursor / component
+        if cursor.is_symlink():
+            raise ValueError(f"Symlinked native extension entry {value!r} in {root}")
+    if source.suffix not in _NATIVE_SUFFIXES or not source.is_file():
+        raise ValueError(
+            f"Missing or unsupported declared native extension {value!r} in {root}. "
+            "Ship the built or vendored artifact; APM does not run npm installs or builds."
+        )
+    return relative.as_posix()
+
+
+def find_extension_bundles(
+    package_path: Path, *, validate_entries: bool = True, is_first_party: bool = False
+) -> list[ExtensionBundle]:
+    """Find native package manifests or designated extension source directories.
+
+    Dependencies keep their full package root to preserve imports and resources.
+    First-party project content is bounded to .apm/extensions; ambient native
+    deployment directories are never promoted back into executable source.
+    Arbitrary root index.js files never opt a package into executable deployment.
+    """
+    package_root = Path(package_path)
+    root = package_root
+    if is_first_party:
+        if native_extension_declaration(package_root) is not None:
+            raise ValueError(
+                "Project-root native extension manifests are not deployable: copying "
+                "the whole project could include private files. Put a self-contained "
+                "extension package and its assets under .apm/extensions instead."
+            )
+        root = package_root / ".apm" / "extensions"
+        from apm_cli.utils.path_security import has_symlink_component
+
+        if has_symlink_component(package_root, root):
+            raise ValueError(f"Symlinked first-party extension source directory: {root}")
+        if not root.is_dir():
+            return []
+    source_directories = (
+        (root,) if is_first_party else tuple(root / source for source in _SOURCE_DIRS)
+    )
+
+    def entry(base: Path, value: str) -> str:
+        return _entry(base, value) if validate_entries else value
+
+    declaration = native_extension_declaration(root)
+    entries: list[str] = []
+    if declaration is not None:
+        entries.extend(entry(root, value) for value in declaration)
+    else:
+        for base in source_directories:
+            if validate_entries and base.is_symlink():
+                raise ValueError(f"Symlinked native extension source directory: {base}")
+            if not base.is_dir():
+                continue
+            for child in sorted(base.iterdir()):
+                if child.is_dir() and (child / ".apm-extension.json").is_file():
+                    continue
+                if validate_entries and child.is_symlink():
+                    raise ValueError(f"Symlinked native extension source: {child}")
+                if child.is_file() and child.suffix in (".ts", ".js"):
+                    entries.append(entry(root, child.relative_to(root).as_posix()))
+                elif child.is_dir():
+                    nested = native_extension_declaration(child)
+                    if nested is not None:
+                        entries.extend(
+                            entry(root, (child.relative_to(root) / entry(child, value)).as_posix())
+                            for value in nested
+                        )
+                    else:
+                        index = next(
+                            (
+                                child / name
+                                for name in ("index.ts", "index.js")
+                                if (child / name).is_file()
+                            ),
+                            None,
+                        )
+                        if index is not None:
+                            entries.append(entry(root, index.relative_to(root).as_posix()))
+    if not entries:
+        return []
+    name = "_local" if is_first_party else root.name
+    return [ExtensionBundle(root, name, tuple(dict.fromkeys(entries)))]
+
+
+def has_native_extension_sources(project_root: Path) -> bool:
+    """Report authored first-party native extension factories without validating entries.
+
+    Existence probe for callers that must keep native sources out of portable
+    layouts or fail closed on them. Structural problems (symlinked or
+    root-manifest sources) count as present; they are reported by the validating
+    :func:`find_extension_bundles` callers, not hidden here.
+    """
+    try:
+        bundles = find_extension_bundles(project_root, validate_entries=False, is_first_party=True)
+        return bool(bundles)
+    except ValueError:
+        return True
+
+
+def is_native_extension_path(relative: str) -> bool:
+    """Identify native executable deployment payloads (not Copilot canvases)."""
+    parts = PurePosixPath(relative.replace("\\", "/")).parts
+    for index, part in enumerate(parts):
+        if part != "extensions":
+            continue
+        if index and parts[index - 1] in (".omp", ".pi"):
+            return True
+        if index >= 2 and parts[index - 2 : index] == (".omp", "agent"):
+            return True
+        if index == 0 or parts[index - 1].startswith("."):
+            return False
+    return False
diff --git a/src/apm_cli/integration/extension_integrator.py b/src/apm_cli/integration/extension_integrator.py
new file mode 100644
index 000000000..d9426e32c
--- /dev/null
+++ b/src/apm_cli/integration/extension_integrator.py
@@ -0,0 +1,433 @@
+"""Owned, resource-preserving native omp extension package deployment."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import shutil
+import tempfile
+from pathlib import Path
+
+from apm_cli.integration.base_integrator import BaseIntegrator, IntegrationResult
+from apm_cli.integration.canvas_integrator import CanvasIntegrator
+from apm_cli.integration.extension_discovery import (
+    ExtensionBundle,
+    find_extension_bundles,
+    native_extension_name,
+)
+from apm_cli.utils.path_security import ensure_path_within, has_symlink_component
+from apm_cli.utils.paths import portable_relpath
+
+RECEIPT_FILENAME = ".apm-extension.json"
+RESERVED_EXTENSION_NAMES = frozenset({"apm-hooks-project", "apm-hooks-user"})
+_IGNORED_DIRS = frozenset({".git", "apm_modules", "__pycache__"})
+
+
+def _digest(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _has_destination_link(path: Path) -> bool:
+    absolute = path.absolute()
+    return has_symlink_component(Path(absolute.anchor), absolute)
+
+
+def _native_names(root: Path, entries: tuple[str, ...]) -> set[str]:
+    names = []
+    for entry in entries:
+        path = root / entry
+        names.append(native_extension_name(path))
+    if len(set(names)) != len(names):
+        raise ValueError(f"Duplicate native extension names in {root}: {names}")
+    return set(names)
+
+
+def _receipt_root_is_safe(root: Path, receipt: Path) -> bool:
+    """Return whether the root and receipt are real (no-follow) directory/file."""
+    return (
+        root.is_dir()
+        and not _has_destination_link(root)
+        and receipt.is_file()
+        and not receipt.is_symlink()
+    )
+
+
+def _read_receipt_hashes(
+    receipt: Path,
+    project_root: Path,
+    owner: str | None,
+    managed_file_hashes,
+) -> dict[str, str] | None:
+    """Load receipt file hashes after baseline, version and owner identity checks."""
+    if managed_file_hashes is not None:
+        from apm_cli.utils.content_hash import compute_file_hash
+
+        expected = managed_file_hashes.get(portable_relpath(receipt, project_root))
+        if expected != compute_file_hash(receipt):
+            return None
+    data = json.loads(receipt.read_text(encoding="utf-8"))
+    hashes = data["files"]
+    if data.get("version") != 1 or not isinstance(hashes, dict):
+        return None
+    if owner is not None and data.get("owner") != owner:
+        return None
+    return hashes
+
+
+def _receipt_entry_is_valid(relative, digest) -> bool:
+    """Return whether a receipt entry names a safe relative payload path and digest."""
+    if not isinstance(relative, str) or not relative or "\\" in relative or ":" in relative:
+        return False
+    parts = Path(relative).parts
+    if Path(relative).is_absolute() or ".." in parts or relative == RECEIPT_FILENAME:
+        return False
+    return isinstance(digest, str)
+
+
+def _claimed_payload_is_verified(
+    root: Path, project_root: Path, managed: set[str], hashes: dict[str, str]
+) -> bool:
+    """Return whether every claimed file is a managed regular file with its raw hash."""
+    for relative, digest in hashes.items():
+        if not _receipt_entry_is_valid(relative, digest):
+            return False
+        path = root / relative
+        ensure_path_within(path, root)
+        if has_symlink_component(root, path) or not path.is_file():
+            return False
+        if portable_relpath(path, project_root) not in managed:
+            return False
+        if _digest(path.read_bytes()) != digest:
+            return False
+    return True
+
+
+def _tree_is_exact(root: Path, hashes: dict[str, str]) -> bool:
+    """Return whether the tree holds exactly the claimed files and their parent dirs."""
+    entries = list(root.rglob("*"))
+    actual = {path.relative_to(root).as_posix() for path in entries if path.is_file()}
+    if actual != set(hashes) | {RECEIPT_FILENAME}:
+        return False
+    expected_dirs = {
+        parent.as_posix()
+        for relative in hashes
+        for parent in Path(relative).parents
+        if parent != Path(".")
+    }
+    for path in entries:
+        if path.is_dir() and path.relative_to(root).as_posix() not in expected_dirs:
+            return False
+        if path.is_symlink() or not (path.is_file() or path.is_dir()):
+            return False
+    return True
+
+
+class ExtensionIntegrator(BaseIntegrator):
+    """Deploy native factories without executing code or mutating host settings."""
+
+    @staticmethod
+    def _payload(bundle: ExtensionBundle, source_plan=None) -> dict[str, bytes]:
+        payload: dict[str, bytes] = {}
+        for directory, dirs, files in os.walk(bundle.source_root, followlinks=False):
+            base = Path(directory)
+            dirs[:] = sorted(
+                name
+                for name in dirs
+                if name not in _IGNORED_DIRS and not (base / name / RECEIPT_FILENAME).is_file()
+            )
+            for name in [*dirs, *files]:
+                if (base / name).is_symlink():
+                    raise ValueError(
+                        f"Native extension resources must not be symlinks: {base / name}"
+                    )
+            for name in sorted(files):
+                if name in (".apm-pin", RECEIPT_FILENAME):
+                    continue
+                source = base / name
+                if not source.is_file():
+                    raise ValueError(f"Native extension resource is not a regular file: {source}")
+                relative = source.relative_to(bundle.source_root).as_posix()
+                if source_plan is not None and not source_plan.includes(
+                    portable_relpath(source, source_plan.source_root)
+                ):
+                    raise ValueError(f"Native extension resource is not authorized: {relative}")
+                payload[relative] = source.read_bytes()
+        for entry in bundle.entries:
+            if entry not in payload:
+                raise ValueError(
+                    f"Declared native extension is absent from the deployable payload: {entry}"
+                )
+        # A manifest makes all designated source layouts discoverable at one
+        # native package root while preserving the original relative imports.
+        manifest = json.loads(payload.get("package.json", b"{}"))
+        if not isinstance(manifest, dict):
+            raise ValueError("Native extension package.json must be an object")
+        native = manifest.get("omp", {})
+        if native is None:
+            native = {}
+        if not isinstance(native, dict):
+            raise ValueError("Native extension package.json omp must be an object")
+        manifest["omp"] = {**native, "extensions": list(bundle.entries)}
+        payload["package.json"] = (
+            json.dumps(manifest, indent=2, ensure_ascii=False) + "\n"
+        ).encode()
+        return payload
+
+    @staticmethod
+    def _name(bundle: ExtensionBundle, package_name: str) -> str:
+        identity = package_name if package_name and package_name != "_local" else bundle.name
+        try:
+            CanvasIntegrator._validate_canvas_name(identity)
+            name = identity
+        except ValueError:
+            # Dependency keys include host ports, local paths and registry scopes.
+            # Hash the complete key rather than using a lossy slash replacement.
+            name = "package-" + hashlib.sha256(identity.encode("utf-8")).hexdigest()
+        if name in RESERVED_EXTENSION_NAMES:
+            raise ValueError(
+                f"Native extension package name '{name}' is reserved for the hook runtime"
+            )
+        return name
+
+    @classmethod
+    def render_payload(
+        cls, bundle: ExtensionBundle, package_name: str = "", source_plan=None
+    ) -> dict[str, bytes]:
+        payload = cls._payload(bundle, source_plan)
+        receipt = {
+            "version": 1,
+            "owner": package_name or cls._name(bundle, package_name),
+            "files": {rel: _digest(data) for rel, data in payload.items()},
+        }
+        payload[RECEIPT_FILENAME] = (json.dumps(receipt, indent=2, sort_keys=True) + "\n").encode()
+        return payload
+
+    @staticmethod
+    def _owned(
+        root: Path,
+        project_root: Path,
+        managed: set[str],
+        *,
+        owner: str | None = None,
+        managed_file_hashes=None,
+    ) -> dict[str, str] | None:
+        receipt = root / RECEIPT_FILENAME
+        if not _receipt_root_is_safe(root, receipt):
+            return None
+        if portable_relpath(receipt, project_root) not in managed:
+            return None
+        try:
+            hashes = _read_receipt_hashes(receipt, project_root, owner, managed_file_hashes)
+            if hashes is None:
+                return None
+            if not _claimed_payload_is_verified(root, project_root, managed, hashes):
+                return None
+            if not _tree_is_exact(root, hashes):
+                return None
+            return hashes
+        except (OSError, ValueError, KeyError, TypeError):
+            return None
+
+    def preflight_extensions_for_targets(
+        self,
+        targets,
+        package_info,
+        project_root,
+        source_plan=None,
+        *,
+        package_name="",
+        managed_files=None,
+        managed_file_hashes=None,
+        scope=None,
+        is_first_party=False,
+    ):
+        """Validate every declared artifact and collision before any primitive writes."""
+        if not any(target.supports("extensions") for target in targets):
+            return
+        bundles = find_extension_bundles(
+            Path(package_info.install_path), is_first_party=is_first_party
+        )
+        from apm_cli.core.scope import InstallScope
+
+        if bundles and is_first_party and scope is InstallScope.USER:
+            raise ValueError(
+                "User-scope native extensions must be installed as a tracked dependency"
+            )
+        managed = self.normalize_managed_files(managed_files) or set()
+        for bundle in bundles:
+            name = self._name(bundle, package_name)
+            self._payload(bundle, source_plan)
+            for target in targets:
+                mapping = target.primitives.get("extensions")
+                if mapping is None:
+                    continue
+                root = (
+                    project_root / (mapping.deploy_root or target.root_dir) / mapping.subdir / name
+                )
+                if _has_destination_link(root):
+                    raise ValueError(f"Symlinked native extension destination: {root}")
+                if (
+                    root.exists()
+                    and self._owned(
+                        root,
+                        project_root,
+                        managed,
+                        owner=package_name or name,
+                        managed_file_hashes=managed_file_hashes,
+                    )
+                    is None
+                ):
+                    raise ValueError(
+                        f"Native extension destination contains foreign or modified files: {root}"
+                    )
+                names = _native_names(root, bundle.entries)
+                reserved = names & RESERVED_EXTENSION_NAMES
+                if reserved:
+                    raise ValueError(
+                        f"Native extension factory names are reserved for the hook runtime: {sorted(reserved)}"
+                    )
+                if root.parent.is_dir():
+                    for sibling in root.parent.iterdir():
+                        if sibling == root or sibling.name.startswith("."):
+                            continue
+                        if sibling.is_file() and sibling.suffix in (".ts", ".js"):
+                            other_names = {sibling.stem}
+                        elif sibling.is_dir():
+                            from apm_cli.integration.extension_discovery import (
+                                native_extension_declaration,
+                            )
+
+                            declared = native_extension_declaration(sibling)
+                            if declared is None:
+                                declared = [
+                                    entry
+                                    for entry in ("index.ts", "index.js")
+                                    if (sibling / entry).is_file()
+                                ][:1]
+                            other_names = _native_names(sibling, tuple(declared))
+                        else:
+                            continue
+                        if names & other_names:
+                            raise ValueError(
+                                f"Native extension name collision with {sibling}: {sorted(names & other_names)}"
+                            )
+
+    def integrate_extensions_for_target(
+        self,
+        target,
+        package_info,
+        project_root,
+        *,
+        force=False,
+        managed_files=None,
+        diagnostics=None,
+        scope=None,
+        trust_extensions=False,
+        is_first_party=False,
+        package_name="",
+        source_plan=None,
+        managed_file_hashes=None,
+    ) -> IntegrationResult:
+        from apm_cli.core.scope import InstallScope
+
+        mapping = target.primitives.get("extensions")
+        if mapping is None or (
+            not trust_extensions and (not is_first_party or scope is InstallScope.USER)
+        ):
+            return IntegrationResult(0, 0, 0, [])
+        self.preflight_extensions_for_targets(
+            [target],
+            package_info,
+            project_root,
+            source_plan,
+            package_name=package_name,
+            managed_files=managed_files,
+            managed_file_hashes=managed_file_hashes,
+            scope=scope,
+            is_first_party=is_first_party,
+        )
+        paths: list[Path] = []
+        integrated = adopted = 0
+        for bundle in find_extension_bundles(
+            Path(package_info.install_path), is_first_party=is_first_party
+        ):
+            name = self._name(bundle, package_name)
+            root = project_root / (mapping.deploy_root or target.root_dir) / mapping.subdir / name
+            payload = self.render_payload(bundle, package_name, source_plan)
+            if all(
+                (root / rel).is_file() and (root / rel).read_bytes() == data
+                for rel, data in payload.items()
+            ):
+                adopted += 1
+            else:
+                root.parent.mkdir(parents=True, exist_ok=True)
+                stage = Path(tempfile.mkdtemp(prefix=f".{name}-", dir=root.parent))
+                backup = None
+                try:
+                    for rel, data in payload.items():
+                        destination = stage / rel
+                        destination.parent.mkdir(parents=True, exist_ok=True)
+                        destination.write_bytes(data)
+                        source = bundle.source_root / rel
+                        if source.is_file() and rel != "package.json":
+                            shutil.copymode(source, destination)
+                    if root.exists():
+                        backup = Path(tempfile.mkdtemp(prefix=f".{name}-old-", dir=root.parent))
+                        backup.rmdir()
+                        root.rename(backup)
+                    try:
+                        stage.rename(root)
+                    except OSError:
+                        if backup is not None:
+                            backup.rename(root)
+                            backup = None
+                        raise
+                    if backup is not None:
+                        shutil.rmtree(backup)
+                    integrated += 1
+                finally:
+                    if stage.exists():
+                        shutil.rmtree(stage)
+            paths.extend(root / rel for rel in payload)
+        return IntegrationResult(integrated, 0, 0, paths, files_adopted=adopted)
+
+    def sync_for_target(
+        self, target, apm_package, project_root, managed_files=None, *, managed_file_hashes=None
+    ) -> dict:
+        """Remove only complete, hash-verified owned native bundles."""
+        mapping = target.primitives.get("extensions")
+        stats = {"files_removed": 0, "errors": 0, "failed_paths": []}
+        if mapping is None:
+            return stats
+        managed = self.normalize_managed_files(managed_files) or set()
+        base = project_root / (mapping.deploy_root or target.root_dir) / mapping.subdir
+        roots = {project_root / rel for rel in managed if Path(rel).name == RECEIPT_FILENAME}
+        for receipt in roots:
+            root = receipt.parent
+            if root.parent != base:
+                continue
+            if _has_destination_link(root):
+                stats["errors"] += 1
+                stats["failed_paths"].extend(
+                    rel for rel in managed if (project_root / rel).is_relative_to(root)
+                )
+                continue
+            hashes = self._owned(
+                root, project_root, managed, managed_file_hashes=managed_file_hashes
+            )
+            if hashes is None:
+                stats["errors"] += 1
+                stats["failed_paths"].extend(
+                    rel for rel in managed if (project_root / rel).is_relative_to(root)
+                )
+                continue
+            try:
+                shutil.rmtree(root)
+                stats["files_removed"] += len(hashes) + 1
+            except OSError:
+                stats["errors"] += 1
+                stats["failed_paths"].extend(
+                    rel for rel in managed if (project_root / rel).is_relative_to(root)
+                )
+        return stats
