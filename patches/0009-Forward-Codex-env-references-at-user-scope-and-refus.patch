+def _try_configure_codex(tmp_path, info) -> tuple[bool, str]:
+    messages: list[str] = []
+
+    def record(message, **_):
+        messages.append(message)
+
+    adapter = CodexClientAdapter(project_root=tmp_path / "project", user_scope=True)
+    with (
