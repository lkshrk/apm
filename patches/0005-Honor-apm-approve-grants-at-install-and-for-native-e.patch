From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lkshrk <dev@harke.me>
Date: Tue, 27 Oct 2026 00:22:23 +0100
Subject: [PATCH 05/14] Honor apm approve grants at install and for native
 extensions without an executables block

The install gate keys a git dependency as github.com/Owner/Repo while
apm approve records the lockfile identity owner/repo, so an approved
native extension stayed gated_pending_approval. The lockfile identity is
now a candidate approval key.

With no executables block the gate is off and the install passes no
allow-map, so a grant from apm approve --user never reached the
extension lookup. Native extensions now also resolve through the trust
ladder that apm approve --list reports.

Version 0.35.0+omni.5.

(cherry picked from commit db584b8815da37502ee4bdbde92d90617e2692e7)
---
 src/apm_cli/install/exec_gate.py              | 38 +++++++++++++---
 .../install/test_native_extension_planning.py | 45 +++++++++++++++++++
 2 files changed, 78 insertions(+), 5 deletions(-)

diff --git a/src/apm_cli/install/exec_gate.py b/src/apm_cli/install/exec_gate.py
index 7d1b2ddc6..bb5128fda 100644
--- a/src/apm_cli/install/exec_gate.py
+++ b/src/apm_cli/install/exec_gate.py
@@ -56,11 +56,7 @@ def check_executable_approval(
     # identity. Package manifest metadata is display-only and must not become
     # an alternate security principal.
     pkg_key = resolve_package_key(package_info, package_name)
-    candidate_keys = [pkg_key]
-
-    name_blind = pkg_key.split("#", 1)[0]
-    if name_blind not in candidate_keys:
-        candidate_keys.append(name_blind)
+    candidate_keys = approval_candidate_keys(package_info, package_name)
 
     hooks_ok = any(
         is_package_approved(allow_executables, k, EXEC_TYPE_HOOKS) for k in candidate_keys
@@ -74,6 +70,17 @@ def check_executable_approval(
     extensions_ok = any(
         is_package_approved(allow_executables, k, EXEC_TYPE_EXTENSIONS) for k in candidate_keys
     )
+    trust_ctx = getattr(ctx, "exec_trust_ctx", None) if ctx is not None else None
+    if not extensions_ok and trust_ctx is not None:
+        # With no executables block the gate is off and the install passes no allow-map, so a grant recorded in
+        # ~/.apm/config.json by ``apm approve --user`` would never reach this lookup. Native extensions always
+        # need a decision, so resolve it through the same ladder ``apm approve --list`` reports.
+        from apm_cli.security.executables import resolve_exec_decision
+
+        extensions_ok = any(
+            resolve_exec_decision(trust_ctx, k, EXEC_TYPE_EXTENSIONS).allowed
+            for k in candidate_keys
+        )
     if is_local or legacy_unrestricted:
         # Preserve legacy local primitive trust, but native code requires the
         # resolver's first-party decision rather than a spoofable display name.
@@ -115,6 +122,27 @@ def check_executable_approval(
     return hooks_ok, bin_ok, mcp_ok, canvas_ok, lsp_ok, extensions_ok
 
 
+def approval_candidate_keys(package_info: Any, package_name: str) -> list[str]:
+    """Return every identity a grant for this package may be recorded under.
+
+    The gate sees the dependency reference as written (``github.com/Owner/Repo``), while ``apm approve`` records
+    the lockfile identity (lowercase, host-less ``owner/repo``). Both name the same resolver-owned dependency, so
+    both count; manifest metadata still never does.
+    """
+    pkg_key = resolve_package_key(package_info, package_name)
+    keys = [pkg_key]
+    name_blind = pkg_key.split("#", 1)[0]
+    if name_blind not in keys:
+        keys.append(name_blind)
+    dep_ref = getattr(package_info, "dependency_ref", None)
+    unique_key = getattr(dep_ref, "get_unique_key", None)
+    if callable(unique_key):
+        identity = unique_key()
+        if identity and identity not in keys:
+            keys.append(identity)
+    return keys
+
+
 def resolve_package_key(package_info: Any, package_name: str) -> str:
     """Build the ``allowExecutables`` lookup key for a package.
 
diff --git a/tests/unit/install/test_native_extension_planning.py b/tests/unit/install/test_native_extension_planning.py
index 8a8577466..8edf1363b 100644
--- a/tests/unit/install/test_native_extension_planning.py
+++ b/tests/unit/install/test_native_extension_planning.py
@@ -118,6 +118,51 @@ def test_native_approval_is_not_canvas_or_spoofed_local_trust(tmp_path):
     assert check_executable_approval("_local", package, {}, is_first_party=True)[-1] is True
 
 
+class _GitRef:
+    """A git dependency: the gate sees the host-qualified string, the lockfile the lowercase identity."""
+
+    def __str__(self):
+        return "github.com/Owner/Repo"
+
+    def get_unique_key(self):
+        return "owner/repo"
+
+
+def test_grant_recorded_by_apm_approve_reaches_the_install_gate(tmp_path):
+    package = SimpleNamespace(dependency_ref=_GitRef(), install_path=tmp_path)
+    recorded = {"owner/repo#abc1234": {"extensions": True}, "owner/repo": {"extensions": True}}
+    assert check_executable_approval("owner/repo", package, recorded)[-1] is True
+    assert (
+        check_executable_approval("owner/repo", package, {"other/repo": {"extensions": True}})[-1]
+        is False
+    )
+
+
+def test_user_grant_approves_native_extensions_while_the_gate_is_disabled(tmp_path, monkeypatch):
+    from dataclasses import replace
+
+    from apm_cli.security import executables
+
+    monkeypatch.setattr(executables, "load_user_executables", lambda **_: ({}, {}))
+    trust = executables.build_exec_trust_context(
+        policy=None, project_data={}, migrate_user_legacy=False
+    )
+    assert not trust.gate_enabled
+    package = SimpleNamespace(dependency_ref=_GitRef(), install_path=tmp_path)
+
+    def approved(context):
+        install = SimpleNamespace(
+            blocked_executables=[], exec_trust_ctx=context, package_exec_status={}
+        )
+        return check_executable_approval("owner/repo", package, None, ctx=install)[-1]
+
+    assert approved(trust) is False
+    granted = replace(trust, user_allow={"owner/repo#abc1234": {"extensions": True}})
+    assert approved(granted) is True
+    denied = replace(granted, user_deny={"owner/repo": {"extensions": True}})
+    assert approved(denied) is False
+
+
 @pytest.mark.parametrize("prefix", [".omp/extensions", ".omp/agent/extensions"])
 def test_native_plugin_paths_preserve_identity_and_resource_names(prefix):
     relative = f"{prefix}/native/assets/config.json"
