From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lkshrk <dev@harke.me>
Date: Sat, 14 Nov 2026 03:11:02 +0100
Subject: [PATCH 10/13] Refuse Codex arg references at user scope and name the
 key in the env hint

---
 src/apm_cli/adapters/client/codex.py          | 24 ++++++++++++++++-
 .../test_user_scope_env_references.py         | 26 +++++++++++++++++++
 2 files changed, 49 insertions(+), 1 deletion(-)

diff --git a/src/apm_cli/adapters/client/codex.py b/src/apm_cli/adapters/client/codex.py
index 31bfc5ab0..069778ff2 100644
--- a/src/apm_cli/adapters/client/codex.py
+++ b/src/apm_cli/adapters/client/codex.py
@@ -528,6 +528,8 @@ class CodexClientAdapter(MCPClientAdapter):
                 "args": [_process_stdio_arg(arg) for arg in raw.get("args") or []],
                 "env": written_env,
             }
+            if self._refuses_arg_references(stdio_config["args"], server_info):
+                return None
             if self.user_scope and not written_env:
                 del stdio_config["env"]
             if raw.get("cwd") is not None:
@@ -746,6 +748,8 @@ class CodexClientAdapter(MCPClientAdapter):
                     )
                 if forwarded_env:
                     config["env_vars"] = forwarded_env
+                if self._refuses_arg_references(config["args"], server_info):
+                    return None
 
         self._merge_extra(config, server_info)
         return config
@@ -856,12 +860,30 @@ class CodexClientAdapter(MCPClientAdapter):
             if isinstance(value, str) and _ENV_PLACEHOLDER_RE.search(value)
         ]
         if keys and not self._rendering_baseline:
+            hints = ", ".join(f"{name}: ${{{name}}}" for name in _ascii_names(keys).split(", "))
             _rich_error(
                 f"Codex cannot keep a secret reference for {_ascii_names([server_name])} "
-                f"env {_ascii_names(keys)}; use KEY: ${{KEY}}"
+                f"env {_ascii_names(keys)}; use {hints}"
             )
         return not keys
 
+    def _refuses_arg_references(self, args: list, server_info: dict) -> bool:
+        """At user scope, refuse args that still hold a reference Codex passes literally."""
+        if not self.user_scope:
+            return False
+        refused = any(
+            isinstance(arg, str)
+            and (_ENV_PLACEHOLDER_RE.search(arg) or _CODEX_UNSUPPORTED_REFERENCE_RE.search(arg))
+            for arg in args
+        )
+        if refused and not self._rendering_baseline:
+            _rich_error(
+                "Codex cannot keep a secret reference for "
+                f"{_ascii_names([server_info.get('name', '')])} args; "
+                "pass the value through env as KEY: ${KEY}"
+            )
+        return refused
+
     def _warn_unforwardable_env(self, literal_env: dict, server_name: str) -> None:
         """Name the env keys whose references Codex cannot forward; never print values."""
         if self._rendering_baseline:
diff --git a/tests/unit/adapters/test_user_scope_env_references.py b/tests/unit/adapters/test_user_scope_env_references.py
index 6cbe6ecc1..de71d4280 100644
--- a/tests/unit/adapters/test_user_scope_env_references.py
+++ b/tests/unit/adapters/test_user_scope_env_references.py
@@ -233,6 +233,7 @@ def test_codex_user_scope_renamed_reference_is_refused(tmp_path, monkeypatch):
     assert ok is False
     assert "s3cret-value" not in text
     assert "Codex cannot keep a secret reference for example env TOKEN" in text
+    assert "use TOKEN: ${TOKEN}" in text
 
 
 def test_codex_user_scope_composite_env_is_refused(tmp_path, monkeypatch):
@@ -303,3 +304,28 @@ def test_codex_user_scope_docker_registry_env_forwarded_with_flag(tmp_path, monk
     assert entry["env_vars"] == ["API_TOKEN"]
     assert entry["args"][-3:-1] == ["-e", "API_TOKEN"]
     assert "s3cret-value" not in _codex_toml_text(tmp_path)
+
+
+@pytest.mark.parametrize("arg", ["${GITHUB_PAT}", "--token=${env:GITHUB_PAT}", "<GITHUB_PAT>"])
+def test_codex_user_scope_stdio_arg_reference_is_refused(tmp_path, monkeypatch, arg):
+    monkeypatch.setenv("GITHUB_PAT", "s3cret-value")
+    info = _codex_stdio_info({"GITHUB_PAT": "${GITHUB_PAT}"})
+    info["_raw_stdio"]["args"] = ["-y", "some-server", arg]
+    ok, text = _try_configure_codex(tmp_path, info)
+    assert ok is False
+    assert "example args" in text
+    assert "s3cret-value" not in text
+    assert _codex_toml_text(tmp_path) == ""
+
+
+def test_codex_user_scope_registry_arg_reference_is_refused(tmp_path, monkeypatch):
+    monkeypatch.setenv("API_TOKEN", "s3cret-value")
+    info = _codex_registry_info([{"name": "API_TOKEN", "required": True}])
+    info["packages"][0]["package_arguments"] = [
+        {"type": "positional", "value": "--token=<API_TOKEN>"}
+    ]
+    ok, text = _try_configure_codex(tmp_path, info)
+    assert ok is False
+    assert "example args" in text
+    assert "s3cret-value" not in text
+    assert _codex_toml_text(tmp_path) == ""
