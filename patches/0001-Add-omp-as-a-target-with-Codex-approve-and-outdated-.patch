+                        }
+                    ]
+                }
+            }
+        )
+    )
+    native_ref = DependencyReference.parse(str(native_source))
+    hook_ref = DependencyReference.parse(str(hook_source))
+    (metadata / "apm.yml").write_text(
+        yaml.safe_dump(
+            {
