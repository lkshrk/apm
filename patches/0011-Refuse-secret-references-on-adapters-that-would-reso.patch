From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lkshrk <dev@harke.me>
Date: Sat, 14 Nov 2026 03:22:27 +0100
Subject: [PATCH 11/13] Refuse secret references on adapters that would resolve
 them

---
 src/apm_cli/adapters/client/base.py           |  25 ++++
 src/apm_cli/adapters/client/codex.py          |   4 +
 src/apm_cli/core/safe_installer.py            |  15 +-
 .../test_user_scope_env_references.py         | 128 ++++++++++++++++++
 4 files changed, 171 insertions(+), 1 deletion(-)

diff --git a/src/apm_cli/adapters/client/base.py b/src/apm_cli/adapters/client/base.py
index 9f1edc2b4..bbc99a87e 100644
--- a/src/apm_cli/adapters/client/base.py
+++ b/src/apm_cli/adapters/client/base.py
@@ -257,6 +257,27 @@ def _has_env_placeholder(value):
     return bool(_ENV_PLACEHOLDER_RE.search(value))
 
 
+def _placeholder_names(value) -> set[str]:
+    if not isinstance(value, str):
+        return set()
+    return {legacy or brace for legacy, brace in _ENV_PLACEHOLDER_RE.findall(value)}
+
+
+def env_references(server_info: dict) -> set[str]:
+    """Return the environment variable names a server's config refers to."""
+    raw = server_info.get("_raw_stdio") or {}
+    values = [*(raw.get("env") or {}).values(), *(raw.get("args") or [])]
+    for remote in server_info.get("remotes") or []:
+        values.extend(header.get("value") for header in remote.get("headers") or [])
+    names = set().union(*map(_placeholder_names, values))
+    if "_raw_stdio" not in server_info:
+        for package in server_info.get("packages") or []:
+            names.update(
+                var["name"] for var in package.get("environment_variables") or [] if var.get("name")
+            )
+    return names
+
+
 def _stringify_env_literal(value):
     """Return MCP env literal values in the manifest ``map<string, string>`` shape."""
     if isinstance(value, bool):
@@ -321,6 +342,10 @@ class MCPClientAdapter(ABC):
     # -> os.environ -> optional interactive prompt. See issue #1152.
     _supports_runtime_env_substitution: bool = False
 
+    def writes_env_references(self) -> bool:
+        """Whether this adapter writes env references instead of resolved values."""
+        return self._supports_runtime_env_substitution
+
     def __init__(
         self,
         project_root: Path | str | None = None,
diff --git a/src/apm_cli/adapters/client/codex.py b/src/apm_cli/adapters/client/codex.py
index 069778ff2..616a31ee9 100644
--- a/src/apm_cli/adapters/client/codex.py
+++ b/src/apm_cli/adapters/client/codex.py
@@ -66,6 +66,10 @@ class CodexClientAdapter(MCPClientAdapter):
     target_name: str = "codex"
     mcp_servers_key: str = "mcp_servers"
 
+    def writes_env_references(self) -> bool:
+        """Codex forwards references itself and refuses those it cannot express."""
+        return True
+
     def __init__(
         self,
         registry_url=None,
diff --git a/src/apm_cli/core/safe_installer.py b/src/apm_cli/core/safe_installer.py
index f7851d471..35f5a8524 100644
--- a/src/apm_cli/core/safe_installer.py
+++ b/src/apm_cli/core/safe_installer.py
@@ -4,6 +4,7 @@ from dataclasses import dataclass
 from pathlib import Path
 from typing import Any
 
+from ..adapters.client.base import env_references
 from ..factory import ClientFactory
 from ..utils.console import _rich_error, _rich_success, _rich_warning
 from .conflict_detector import MCPConflictDetector
@@ -120,6 +121,12 @@ class SafeMCPInstaller:
                 continue
 
             try:
+                if self._would_resolve_references(cached_info):
+                    reason = f"{self.runtime} cannot keep secret references at user scope"
+                    summary.add_failed(server_ref, reason)
+                    self._log_error(server_ref, reason)
+                    continue
+
                 # Pass environment overrides, server info cache, and runtime variables if provided
                 kwargs = {}
                 if env_overrides is not None:
@@ -155,6 +162,12 @@ class SafeMCPInstaller:
 
         return summary
 
+    def _would_resolve_references(self, server_info: dict[str, Any] | None) -> bool:
+        """True when a user-scope adapter would write referenced secrets as values."""
+        if not self.adapter.user_scope or self.adapter.writes_env_references():
+            return False
+        return bool(server_info) and bool(env_references(server_info))
+
     def _log_skip(self, server_ref: str):
         """Log when a server is skipped due to existing configuration."""
         if self.logger:
@@ -176,7 +189,7 @@ class SafeMCPInstaller:
         else:
             _rich_warning(f"  x {server_ref} installation failed")
 
-    def _log_error(self, server_ref: str, error: Exception):
+    def _log_error(self, server_ref: str, error: Exception | str):
         """Log error during server installation."""
         if self.logger:
             self.logger.error(f"  x {server_ref}: {error}")
diff --git a/tests/unit/adapters/test_user_scope_env_references.py b/tests/unit/adapters/test_user_scope_env_references.py
index de71d4280..808589d49 100644
--- a/tests/unit/adapters/test_user_scope_env_references.py
+++ b/tests/unit/adapters/test_user_scope_env_references.py
@@ -10,8 +10,11 @@ import pytest
 import tomlkit
 
 from apm_cli.adapters.client import codex as codex_module
+from apm_cli.adapters.client.base import env_references
 from apm_cli.adapters.client.claude import ClaudeClientAdapter
 from apm_cli.adapters.client.codex import CodexClientAdapter
+from apm_cli.adapters.client.opencode import OpenCodeClientAdapter
+from apm_cli.core.safe_installer import SafeMCPInstaller
 from apm_cli.integration.mcp_integrator import MCPIntegrator
 from apm_cli.models.dependency.mcp import MCPDependency
 
@@ -329,3 +332,128 @@ def test_codex_user_scope_registry_arg_reference_is_refused(tmp_path, monkeypatc
     assert "example args" in text
     assert "s3cret-value" not in text
     assert _codex_toml_text(tmp_path) == ""
+
+
+@pytest.fixture
+def _user_home(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    home.mkdir(exist_ok=True)
+    monkeypatch.setenv("HOME", str(home))
+    monkeypatch.delenv("HERMES_HOME", raising=False)
+    monkeypatch.setattr(Path, "home", lambda: home)
+    return home
+
+
+def _stdio_info(name, env):
+    dep = MCPDependency.from_dict(
+        {
+            "name": name,
+            "registry": False,
+            "transport": "stdio",
+            "command": "npx",
+            "args": ["-y", "some-server"],
+            "env": env,
+        }
+    )
+    return MCPIntegrator._build_self_defined_info(dep)
+
+
+def _install(tmp_path, runtime, servers):
+    installer = SafeMCPInstaller(runtime, project_root=tmp_path / "project", user_scope=True)
+    cache = {name: _stdio_info(name, env) for name, env in servers.items()}
+    return installer.install_servers(list(servers), server_info_cache=cache)
+
+
+def _install_one(tmp_path, runtime, env):
+    return _install(tmp_path, runtime, {"example": env})
+
+
+def _all_written_text(tmp_path: Path) -> str:
+    return "\n".join(
+        p.read_text(errors="replace") for p in sorted(tmp_path.rglob("*")) if p.is_file()
+    )
+
+
+def _configure_opencode_stdio(tmp_path, env):
+    adapter = OpenCodeClientAdapter(project_root=tmp_path / "project", user_scope=True)
+    info = _stdio_info("example", env)
+    assert adapter.configure_mcp_server("example", server_info_cache={"example": info})
+    path = Path(adapter.get_config_path())
+    assert "s3cret-value" not in path.read_text()
+    return json.loads(path.read_text())["mcp"]["example"]
+
+
+@pytest.mark.usefixtures("_user_home")
+@pytest.mark.parametrize("runtime", ["gemini", "hermes", "windsurf"])
+def test_resolving_adapter_refuses_referencing_server(tmp_path, monkeypatch, runtime):
+    monkeypatch.setenv("GITHUB_PAT", "s3cret-value")
+    summary = _install_one(tmp_path, runtime, env={"GITHUB_PAT": "${GITHUB_PAT}"})
+    assert summary.failed and not summary.installed
+    assert summary.failed[0]["reason"] == f"{runtime} cannot keep secret references at user scope"
+    assert "s3cret-value" not in _all_written_text(tmp_path)
+
+
+@pytest.mark.usefixtures("_user_home")
+@pytest.mark.parametrize("runtime", ["gemini", "hermes", "windsurf"])
+def test_resolving_adapter_installs_server_without_references(tmp_path, runtime):
+    summary = _install_one(tmp_path, runtime, env={"MODE": "fast"})
+    assert summary.installed
+
+
+@pytest.mark.usefixtures("_user_home")
+@pytest.mark.parametrize("runtime", ["gemini", "hermes", "windsurf", "codex"])
+def test_refused_server_does_not_stop_the_others(tmp_path, monkeypatch, runtime):
+    monkeypatch.setenv("GITHUB_PAT", "s3cret-value")
+    refused_env = (
+        {"TOKEN": "${GITHUB_PAT}"} if runtime == "codex" else {"GITHUB_PAT": "${GITHUB_PAT}"}
+    )
+    summary = _install(
+        tmp_path,
+        runtime,
+        {"first": {"MODE": "fast"}, "refused": refused_env, "last": {"MODE": "slow"}},
+    )
+    assert summary.installed == ["first", "last"]
+    assert [item["server"] for item in summary.failed] == ["refused"]
+    assert "s3cret-value" not in _all_written_text(tmp_path)
+
+
+@pytest.mark.usefixtures("_user_home")
+@pytest.mark.parametrize("runtime", ["claude", "codex", "opencode"])
+def test_reference_writing_adapter_is_not_refused(tmp_path, monkeypatch, runtime):
+    monkeypatch.delenv("CLAUDE_CONFIG_DIR", raising=False)
+    monkeypatch.setenv("GITHUB_PAT", "s3cret-value")
+    summary = _install_one(tmp_path, runtime, env={"GITHUB_PAT": "${GITHUB_PAT}"})
+    assert summary.installed == ["example"]
+    assert "s3cret-value" not in _all_written_text(tmp_path)
+
+
+def test_writes_env_references_per_adapter(tmp_path):
+    root = tmp_path / "project"
+    assert CodexClientAdapter(project_root=root, user_scope=True).writes_env_references()
+    assert ClaudeClientAdapter(project_root=root, user_scope=True).writes_env_references()
+    assert not ClaudeClientAdapter(project_root=root, user_scope=False).writes_env_references()
+
+
+@pytest.mark.usefixtures("_user_home")
+def test_opencode_user_scope_writes_env_placeholder(tmp_path, monkeypatch):
+    monkeypatch.setenv("GITHUB_PAT", "s3cret-value")
+    entry = _configure_opencode_stdio(tmp_path, env={"GITHUB_PAT": "${GITHUB_PAT}"})
+    assert entry["environment"]["GITHUB_PAT"] == "{env:GITHUB_PAT}"
+
+
+def test_env_references_collects_all_sources():
+    info = {
+        "_raw_stdio": {"env": {"A": "${A}"}, "args": ["--t=${B}"]},
+        "remotes": [{"headers": [{"name": "H", "value": "Bearer ${C}"}]}],
+    }
+    assert env_references(info) == {"A", "B", "C"}
+
+
+def test_env_references_includes_registry_env_names_and_ignores_literals():
+    info = {
+        "_raw_stdio": {"env": {"MODE": "fast"}, "args": ["-y", "<D>"]},
+        "remotes": [{"headers": [{"name": "X", "value": "${env:E}"}]}],
+    }
+    assert env_references(info) == {"D", "E"}
+    assert env_references(_codex_registry_info([{"name": "F"}])) == {"F"}
+    assert env_references(_stdio_info("example", {"MODE": "fast"})) == set()
