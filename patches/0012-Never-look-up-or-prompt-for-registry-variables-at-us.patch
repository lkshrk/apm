From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lkshrk <dev@harke.me>
Date: Sat, 14 Nov 2026 03:35:07 +0100
Subject: [PATCH 12/13] Never look up or prompt for registry variables at user
 scope and refuse unverifiable servers

---
 src/apm_cli/adapters/client/base.py           |  6 +-
 src/apm_cli/core/safe_installer.py            | 19 ++--
 .../integration/mcp_integrator_install.py     | 32 ++++--
 .../test_user_scope_env_references.py         | 99 +++++++++++++++++++
 4 files changed, 139 insertions(+), 17 deletions(-)

diff --git a/src/apm_cli/adapters/client/base.py b/src/apm_cli/adapters/client/base.py
index bbc99a87e..562e292a7 100644
--- a/src/apm_cli/adapters/client/base.py
+++ b/src/apm_cli/adapters/client/base.py
@@ -268,7 +268,11 @@ def env_references(server_info: dict) -> set[str]:
     raw = server_info.get("_raw_stdio") or {}
     values = [*(raw.get("env") or {}).values(), *(raw.get("args") or [])]
     for remote in server_info.get("remotes") or []:
-        values.extend(header.get("value") for header in remote.get("headers") or [])
+        headers = remote.get("headers") or []
+        if isinstance(headers, dict):
+            values.extend(headers.values())
+        else:
+            values.extend(h.get("value") for h in headers if isinstance(h, dict))
     names = set().union(*map(_placeholder_names, values))
     if "_raw_stdio" not in server_info:
         for package in server_info.get("packages") or []:
diff --git a/src/apm_cli/core/safe_installer.py b/src/apm_cli/core/safe_installer.py
index 35f5a8524..99d33df19 100644
--- a/src/apm_cli/core/safe_installer.py
+++ b/src/apm_cli/core/safe_installer.py
@@ -121,8 +121,8 @@ class SafeMCPInstaller:
                 continue
 
             try:
-                if self._would_resolve_references(cached_info):
-                    reason = f"{self.runtime} cannot keep secret references at user scope"
+                reason = self._user_scope_refusal(server_ref, cached_info)
+                if reason:
                     summary.add_failed(server_ref, reason)
                     self._log_error(server_ref, reason)
                     continue
@@ -162,11 +162,18 @@ class SafeMCPInstaller:
 
         return summary
 
-    def _would_resolve_references(self, server_info: dict[str, Any] | None) -> bool:
-        """True when a user-scope adapter would write referenced secrets as values."""
+    def _user_scope_refusal(self, server_ref: str, server_info: dict[str, Any] | None) -> str:
+        """Why a user-scope adapter that resolves references must not configure this server."""
         if not self.adapter.user_scope or self.adapter.writes_env_references():
-            return False
-        return bool(server_info) and bool(env_references(server_info))
+            return ""
+        if server_info is None:
+            return (
+                f"server info for {server_ref} unavailable; "
+                "cannot verify it has no secret references"
+            )
+        if env_references(server_info):
+            return f"{self.runtime} cannot keep secret references at user scope"
+        return ""
 
     def _log_skip(self, server_ref: str):
         """Log when a server is skipped due to existing configuration."""
diff --git a/src/apm_cli/integration/mcp_integrator_install.py b/src/apm_cli/integration/mcp_integrator_install.py
index 0c3e9118d..2918be170 100644
--- a/src/apm_cli/integration/mcp_integrator_install.py
+++ b/src/apm_cli/integration/mcp_integrator_install.py
@@ -163,6 +163,26 @@ def _announce_registry_endpoint(registry_client: Any, logger: Any) -> None:
     logger.progress(f"Using MCP registry: {safe_url} ({label})", symbol="info")
 
 
+def _collect_shared_variables(
+    operations: Any,
+    servers: list[str],
+    server_info_cache: dict,
+    group_dep_map: dict,
+    user_scope: bool,
+) -> tuple[dict[str, str], dict[str, str]]:
+    """Collect registry env and runtime variables; user scope never looks up or prompts."""
+    env_vars: dict[str, str] = {}
+    runtime_vars: dict[str, str] = {}
+    if not user_scope:
+        env_vars = operations.collect_environment_variables(servers, server_info_cache)
+        runtime_vars = operations.collect_runtime_variables(servers, server_info_cache)
+    for server_name in servers:
+        dep = group_dep_map.get(server_name)
+        if dep and dep.env:
+            env_vars.update(dep.env)
+    return env_vars, runtime_vars
+
+
 def _install_registry_group(  # noqa: PLR0913
     operations: Any,
     group_dep_names: list,
@@ -298,16 +318,8 @@ def _install_registry_group(  # noqa: PLR0913
                 if dep:
                     MCPIntegrator._apply_overlay(server_info_cache, dep)
 
-            # Collect env and runtime variables
-            shared_env_vars = operations.collect_environment_variables(
-                servers_to_install, server_info_cache
-            )
-            for server_name in servers_to_install:
-                dep = group_dep_map.get(server_name)
-                if dep and dep.env:
-                    shared_env_vars.update(dep.env)
-            shared_runtime_vars = operations.collect_runtime_variables(
-                servers_to_install, server_info_cache
+            shared_env_vars, shared_runtime_vars = _collect_shared_variables(
+                operations, servers_to_install, server_info_cache, group_dep_map, user_scope
             )
 
             # Install for each target runtime
diff --git a/tests/unit/adapters/test_user_scope_env_references.py b/tests/unit/adapters/test_user_scope_env_references.py
index 808589d49..b5f55f138 100644
--- a/tests/unit/adapters/test_user_scope_env_references.py
+++ b/tests/unit/adapters/test_user_scope_env_references.py
@@ -457,3 +457,102 @@ def test_env_references_includes_registry_env_names_and_ignores_literals():
     assert env_references(info) == {"D", "E"}
     assert env_references(_codex_registry_info([{"name": "F"}])) == {"F"}
     assert env_references(_stdio_info("example", {"MODE": "fast"})) == set()
+
+
+@pytest.mark.parametrize(
+    ("headers", "expected"),
+    [({"X-Mode": "fast"}, set()), ({"X-Key": "${X}"}, {"X"})],
+)
+def test_env_references_accepts_mapping_headers(headers, expected):
+    assert env_references({"remotes": [{"headers": headers}]}) == expected
+
+
+@pytest.mark.usefixtures("_user_home")
+@pytest.mark.parametrize("runtime", ["hermes", "windsurf"])
+def test_mapping_header_server_installs_beside_others(tmp_path, runtime):
+    installer = SafeMCPInstaller(runtime, project_root=tmp_path / "project", user_scope=True)
+    remote = {"transport_type": "http", "url": "https://example.test/mcp"}
+    info = {"name": "remote", "remotes": [{**remote, "headers": {"X-Mode": "fast"}}]}
+    cache = {"remote": info, "local": _stdio_info("local", {"MODE": "fast"})}
+    summary = installer.install_servers(["remote", "local"], server_info_cache=cache)
+    assert summary.installed == ["remote", "local"]
+
+
+@pytest.mark.usefixtures("_user_home")
+@pytest.mark.parametrize("runtime", ["gemini", "hermes", "windsurf"])
+def test_resolving_adapter_refuses_server_without_info(tmp_path, runtime):
+    installer = SafeMCPInstaller(runtime, project_root=tmp_path / "project", user_scope=True)
+    cache = {"unknown": None, "local": _stdio_info("local", {"MODE": "fast"})}
+    summary = installer.install_servers(["unknown", "local"], server_info_cache=cache)
+    assert summary.installed == ["local"]
+    assert summary.failed == [
+        {
+            "server": "unknown",
+            "reason": "server info for unknown unavailable; "
+            "cannot verify it has no secret references",
+        }
+    ]
+
+
+def _registry_operations(info):
+    from apm_cli.registry.operations import MCPServerOperations
+
+    operations = MCPServerOperations()
+    operations.validate_servers_exist = mock.Mock(return_value=(["example"], []))
+    operations.check_servers_needing_installation = mock.Mock(return_value=["example"])
+    operations.batch_fetch_server_info = mock.Mock(return_value={"example": info})
+    return operations
+
+
+def test_user_scope_registry_install_never_looks_up_or_prompts(tmp_path, monkeypatch, _user_home):
+    import os
+
+    from apm_cli.integration.mcp_integrator_install import _install_registry_group
+
+    real_getenv = os.getenv
+
+    def guarded_getenv(name, *args):
+        if name in {"API_TOKEN", "ADO_ORG"}:
+            raise AssertionError(f"looked up {name}")
+        return real_getenv(name, *args)
+
+    for var in ("CI", "GITHUB_ACTIONS", "TRAVIS", "JENKINS_URL", "BUILDKITE", "APM_E2E_TESTS"):
+        monkeypatch.delenv(var, raising=False)
+    monkeypatch.delenv("CLAUDE_CONFIG_DIR", raising=False)
+    monkeypatch.setenv("API_TOKEN", "s3cret-value")
+    monkeypatch.setattr("sys.stdin.isatty", lambda: True)
+    monkeypatch.setattr("sys.stdout.isatty", lambda: True)
+    monkeypatch.setattr("rich.prompt.Prompt.ask", _fail_if_called)
+    monkeypatch.setattr(os, "getenv", guarded_getenv)
+    info = _codex_registry_info([{"name": "API_TOKEN", "required": True}])
+    info["packages"][0]["package_arguments"] = [
+        {
+            "type": "named",
+            "name": "--org",
+            "value": "{ado_org}",
+            "variables": {"ado_org": {"is_required": True, "is_secret": True}},
+        }
+    ]
+    managed: dict[str, set[str]] = {}
+
+    configured = _install_registry_group(
+        operations=_registry_operations(info),
+        group_dep_names=["example"],
+        group_dep_map={},
+        group_deps=["example"],
+        target_runtimes=["claude"],
+        stored_mcp_configs={},
+        servers_to_update=set(),
+        successful_updates=set(),
+        project_root=tmp_path / "project",
+        user_scope=True,
+        verbose=False,
+        console=None,
+        logger=mock.MagicMock(),
+        managed_target_servers=managed,
+    )
+
+    assert configured == 1
+    assert managed == {"claude": {"example"}}
+    assert _written_entry(tmp_path)["env"]["API_TOKEN"] == "${API_TOKEN}"
+    assert "s3cret-value" not in _claude_json_text(tmp_path)
