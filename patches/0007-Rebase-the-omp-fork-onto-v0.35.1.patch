 src/apm_cli/adapters/client/omp.py            |  4 +--
 src/apm_cli/commands/uninstall/cli.py         | 35 ++++++++++++-------
 src/apm_cli/install/services.py               | 22 ++++++++----
 .../install/test_architecture_invariants.py   |  5 ++-
 4 files changed, 43 insertions(+), 23 deletions(-)

